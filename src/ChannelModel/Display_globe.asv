%% Display_globe function
% This function displays the 3D view of the globe, highligthing the users
% and the satellites after filtering

%%%%%% ----- INPUT PARAMETERS ----- %%%%%%
%       1. filteredSimScen: filtered satelliteScenario object of the toolbox

function []=Display_globe(filteredSimScen)

% Init viewer object
viewer = satelliteScenarioViewer(filteredSimScen);

% Show orbit traces
orb = orbit(filteredSimScen.Satellites);
show(orb);

play(filteredSimScen);


end

%% Display_Globe function
% This function opens the satelliteScenario viewer associated to the current
% simulation scenario and visualizes both the satellites and the ground
% stations/users already instantiated in the scenario object.
% In particular, the function:
%       (i) opens the 3D globe viewer,
%       (ii) displays the orbital traces of the satellites,
%       (iii) enables labels for both satellites and ground stations,
%       (iv) plays the scenario evolution over time.
%
% The function assumes that the input satelliteScenario object has already
% been populated with Satellite objects and, possibly, GroundStation
% objects representing the fixed-position users.

%%%%%% ----- INPUT PARAMETERS ----- %%%%%%
%       1. simulationScenario : satelliteScenario object of the toolbox to
%       be visualized through the globe viewer
%
%%%%%% ----- OUTPUT PARAMETERS ----- %%%%%%
%       1. viewer : satelliteScenarioViewer object associated to the input
%       scenario

function [viewer] = Display_Globe(simulationScenario)

%% Retrieval of the objects already stored in the scenario
% We retrieve satellites and ground stations directly from the scenario
% object so that their graphical properties can be modified before playing
% the simulation
sats = simulationScenario.Satellites;
gss  = simulationScenario.GroundStations;

%% Viewer creation
% The viewer is the object responsible for the visualization of the
% satelliteScenario on the 3D globe
viewer = satelliteScenarioViewer(simulationScenario);

%% Satellite visualization settings
% If satellites are present in the scenario, we display their orbits and
% enable their labels
if ~isempty(sats)
    show(orbit(sats));

    for currentSat = 1:numel(sats)
        sats(currentSat).ShowLabel = true;
        sats(currentSat).LabelFontSize = 10;
    end
end

%% Ground station visualization settings
% If ground stations are present in the scenario, we enable their labels as
% well. In the current project, these ground stations represent the users
if ~isempty(gss)
    for currentGs = 1:numel(gss)
        gss(currentGs).ShowLabel = true;
        gss(currentGs).LabelFontSize = 10;
    end
end

%% Scenario playback
% Once all graphical settings have been configured, the scenario is played
% over the considered simulation time window
play(simulationScenario);

end