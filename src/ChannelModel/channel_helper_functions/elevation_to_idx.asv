function elevIdx = elevation_to_idx(thetaDeg)
% creating different environments indeces. The scope is to align the
% strings defining the environments to the cell based access to the bank of
% channels.
if thetaDeg < 25
    elevIdx = NaN;

elseif thetaDeg < 37.5
    elevIdx = 1;      % 30 deg

elseif thetaDeg < 52.5
    elevIdx = 2;      % 45 deg

elseif thetaDeg < 65
    elevIdx = 3;      % 60 deg

else
    elevIdx = 4;      % 70 deg

end

end