function []=Satellite_constellation()

alt_km = 550;
inc_deg = 53;

totalPlanes = 72;
satsPerPlane = 22;
F=17;

earthRadius_km = 6371;
semiMajorAxis_m = (earthRadius_km + alt_km) * 1e3;
phaseOffsetPerPlane_deg = F*360 / (22 * 72);

satCount = 0;

for p = totalPlanes
    % RAAN spacing over the currently modeled shell
    raan = (p-1) * 360 / totalPlanes;

    for m = 1:satsPerPlane
        % Satellite position inside the plane
        ta = (m-1) * 360 / satsPerPlane;

        % Thesis-inspired plane-dependent phase shift
        ta = mod(ta + (p-1) * phaseOffsetPerPlane_deg, 360);

        satCount = satCount + 1;

        satellite(sc, ...
            semiMajorAxis_m, ...
            0, ...
            inc_deg, ...
            raan, ...
            0, ...
            ta, ...
            Name=sprintf("SAT_%d_%d", p, m));
    end
end

satObjs = sc.Satellites;

end